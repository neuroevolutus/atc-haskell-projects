cabal-version: 2.2
-- todo-manager.cabal
name: todo-manager
version: 0.1.0.0
description: A simple todo manager
category: CLI
build-type: Simple

common base-and-compiler-flags
  build-depends: base >=4.7 && <5
  ghc-options:
    -O2
    -Weverything

  default-extensions: BlockArguments

library
  import: base-and-compiler-flags
  hs-source-dirs: lib
  exposed-modules: TodoManager
  default-language: GHC2024
  build-depends:
    beam-core >=0.10.3.1 && <0.10.4,
    beam-sqlite >=0.5.4.0 && <0.5.5,
    microlens >=0.4.14 && < 0.5,
    sqlite-simple >=0.4.19.0 && <0.4.20,
    text,
    time,

executable todo-manager-cli
  import: base-and-compiler-flags
  main-is: Main.hs
  hs-source-dirs: src
  default-language: GHC2024
  build-depends:
    directory >=1.3.9.0 && <1.4,
    filepath >=1.5.4.0 && <1.6,
    todo-manager,

  other-modules:
    Configuration
    SchemaDefinition

test-suite test
  import: base-and-compiler-flags
  default-language: GHC2024
  type:
    exitcode-stdio-1.0

  hs-source-dirs:
    test

  main-is:
    Test.hs

  build-depends:
    hspec >=2.11.11 && <2.12,
    tasty >=1.5.3 && <1.6,
    tasty-hspec >=1.2.0.4 && <1.2.1,
    todo-manager,
